{
    "name": "electronic-journal",
    "version": "1.0.0",
    "description": "Електронний журнал — навчальний бекенд-застосунок для обліку оцінок студентів",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "node --watch --import tsx/esm src/server.ts",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:smoke": "vitest run --project smoke",
        "test:coverage": "vitest run --coverage",
        "typecheck:tests": "tsc -p tests/tsconfig.json",
        "build": "tsc",
        "db:migrate": "node --import tsx/esm src/db/runSqlFile.ts db/migrations/001_initial.sql",
        "db:seed": "node --import tsx/esm src/db/runSqlFile.ts db/seed.sql",
        "db:clear": "node --import tsx/esm src/db/runSqlFile.ts db/clear.sql",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "dotenv": "^16.4.5",
        "fastify": "^4.26.2",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^26.6.4",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.0.0",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "5.9",
        "typescript-eslint": "^8.71.2",
        "vitest": "4.1.12"
    }
}
